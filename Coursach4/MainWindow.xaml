<Window x:Class="Coursach4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Coursach4.Converters"
        mc:Ignorable="d"
        Title="Симуляція кіосків на стадіоні" Height="820" Width="1200">
    <Window.Resources>
        <conv:KioskPhaseToUkrainianConverter x:Key="KioskPhaseToUkrainianConverter"/>
        <conv:KioskPhaseToIconConverter x:Key="KioskPhaseToIconConverter"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Старт" Width="90" Margin="0,0,8,0" Command="{Binding StartCommand}"/>
            <Button Content="Стоп" Width="90" Margin="0,0,8,0" Command="{Binding StopCommand}"/>
            <Button Content="Скинути" Width="90" Margin="0,0,8,0" Command="{Binding ResetCommand}"/>
            <Button Content="Очистити лог" Width="120" Margin="0,0,8,0" Command="{Binding ClearLogCommand}"/>
            <Button Content="Експорт CSV" Width="120" Command="{Binding ExportCsvCommand}"/>
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Kiosks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="DarkGray" BorderThickness="1" Margin="4" Padding="8" MinHeight="240">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock FontWeight="Bold"
                                           FontSize="24"
                                           Text="{Binding KioskId, StringFormat=Кіоск №{0}}"/>
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding Phase, Converter={StaticResource KioskPhaseToUkrainianConverter}, StringFormat=Стан: {0}}"/>
                                <TextBlock Text="{Binding PhaseRemaining, StringFormat=Залишилось (с): {0}}"/>
                                <TextBlock Text="{Binding QueueLength, StringFormat=Черга: {0}}"/>
                                <TextBlock Text="{Binding VegetablePortions, StringFormat=Порцій овочів: {0}}"/>
                                <TextBlock Text="{Binding SuccessCount, StringFormat=Успішно: {0}}"/>
                                <TextBlock Text="{Binding RejectedByVegetablesCount, StringFormat=Відмов через овочі: {0}}"/>
                                <TextBlock Text="{Binding PeakQueueLength, StringFormat=Пікова черга: {0}}"/>
                                <TextBlock Text="{Binding Utilization, StringFormat=Завантаження: {0}}"/>
                            </StackPanel>

                            <Grid Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <Image Width="132"
                                       Height="132"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{Binding Phase, Converter={StaticResource KioskPhaseToIconConverter}}"
                                       Stretch="Uniform"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" BorderBrush="DarkGray" BorderThickness="1" Padding="8" Margin="0,10,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,16,0" Text="{Binding TotalSuccess, StringFormat=Загалом успішно: {0}}"/>
                <TextBlock Margin="0,0,16,0" Text="{Binding TotalRejectedVegetables, StringFormat=Відмов через овочі: {0}}"/>
                <TextBlock Margin="0,0,16,0" Text="{Binding RejectedByQueue, StringFormat=Відмов через чергу: {0}}"/>
                <TextBlock Text="{Binding AverageWaitSeconds, StringFormat=Середнє очікування (с): {0:F1}}"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding Events}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="UTC" Binding="{Binding TimestampUtc, StringFormat=HH:mm:ss.fff}" Width="150"/>
                <DataGridTextColumn Header="Від старту" Binding="{Binding SinceStart, StringFormat=mm\\:ss}" Width="100"/>
                <DataGridTextColumn Header="Кіоск" Binding="{Binding KioskId}" Width="60"/>
                <DataGridTextColumn Header="Подія" Binding="{Binding EventType}" Width="220"/>
                <DataGridTextColumn Header="Повідомлення" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
